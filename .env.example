# 业务 API 地址。启动 mock_api 后保持默认即可。
BUSINESS_API_URL=http://127.0.0.1:8000
DEFAULT_USER_ID=U1001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only development enables the public, local test credentials.
SUPPORT_ENV=development
# Production must explicitly set private credentials (or integrate OIDC).
# SUPPORT_AUTH_TOKENS={"replace-with-private-token":{"user_id":"U1001","role":"customer"},"replace-with-reviewer-token":{"user_id":"S1001","role":"support"}}
# SUPPORT_DATA_DIR=/var/lib/support
LLM_INTENT_ENABLED=false

# 有界会话上下文；历史消息数量 1..50，总序列化字符数 256..24000
CHAT_HISTORY_WINDOW=10
CHAT_CONTEXT_ENABLED=true
CHAT_MAX_CONTEXT_CHARS=12000
# 可选：覆盖评测报告目录；默认 evaluation/reports（只读展示给客服）
# EVALUATION_REPORT_DIR=
LLM_TIMEOUT_SECONDS=20
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# 后续你接入真实大模型时再配置：
# OPENAI_API_KEY=xxx
# DEEPSEEK_API_KEY=xxx
# DASHSCOPE_API_KEY=xxx
