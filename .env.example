# 业务 API 地址。启动 mock_api 后保持默认即可。
BUSINESS_API_URL=http://127.0.0.1:8000
DEFAULT_USER_ID=U1001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only development enables the public, local test credentials.
SUPPORT_ENV=development
# Production must explicitly set private credentials (or integrate OIDC).
# SUPPORT_AUTH_TOKENS={"replace-with-private-token":{"user_id":"U1001","role":"customer"},"replace-with-reviewer-token":{"user_id":"S1001","role":"support"}}
# SUPPORT_DATA_DIR=/var/lib/support
LLM_INTENT_ENABLED=false

# 有界会话上下文；历史消息数量 1..50，总序列化字符数 256..24000
CHAT_HISTORY_WINDOW=10
CHAT_CONTEXT_ENABLED=true
CHAT_MAX_CONTEXT_CHARS=12000
# 可选：覆盖评测报告目录；默认 evaluation/reports（只读展示给客服）
# EVALUATION_REPORT_DIR=
LLM_TIMEOUT_SECONDS=20
# 单次模型任务最多额外重试0..2次；SDK隐式重试关闭，评测预算包含每次重试
LLM_MAX_RETRIES=1
# 温度0..2；超时0.1..120秒。下面三项必须同时明确配置才能调用模型，无默认模型
LLM_TEMPERATURE=0.2
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# 项目实际读取上面的 LLM_* 名称；不要将 Key 放进 VITE_* 或截图。
# 先执行 python -m evaluation.run_evaluation --check-config（只校验，不联网）。

# Phase 3A: 默认完全保留TF-IDF，不复用聊天模型/Key。
RAG_MODE=tfidf
EMBEDDING_ENABLED=false
RAG_REMOTE_QUERY_ENABLED=false
# 可选后端路径；默认仓库 .rag_cache，整个目录不得上传Git。
# RAG_CACHE_DIR=
RAG_RRF_K=60
RAG_CANDIDATES=20
# 每次服务端政策查询的请求尝试上限（包括重试），不是账户人民币预算。
RAG_QUERY_MAX_EMBEDDING_CALLS=2
# 模型、地域地址、维度均需明确配置，空值不会自动使用聊天模型。
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_RETRIES=1
# 仅仓库模拟政策可用于本阶段在线构建；远程查询会外发最小化后的问题文本。
# 更改模式后重启服务。缺索引只回退TF-IDF，不会启动时付费重建。
